# ---- Language model --------------------------------------------------------
# fake      = offline test model (no key, not intelligent; for checking the plumbing)
# anthropic = Claude        openai = OpenAI or any OpenAI-compatible server
LLM_PROVIDER=anthropic
LLM_MODEL=                      # empty = sensible default per provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Exemple Groq : OPENAI_BASE_URL=https://api.groq.com/openai/v1  et  LLM_MODEL=openai/gpt-oss-120b

# ---- Embeddings and CLIP ---------------------------------------------------
# auto = sentence-transformers if installed, else offline hash fallback (poor quality)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLIP_MODE=auto                  # auto | on | off  (off/unavailable = caption-based image search)
CLIP_MODEL=clip-ViT-B-32

# ---- Web search (hybrid fallback) -----------------------------------------
WEB_PROVIDER=tavily             # tavily | ddgs | none
TAVILY_API_KEY=
WEB_MAX_RESULTS=4
WEB_BLOCKED_DOMAINS=

# ---- Pipeline tuning -------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
GRAPH_EXTRACTION=true           # builds the knowledge graph (one LLM call per chunk)
GRAPH_HOPS=1
MAX_VERIFY_LOOPS=1
# MIN_LOCAL_SCORE=0.25          # relevance floor; unset = default of the embedding model

# ---- Server ----------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=50
USE_MOCK_CORE=false             # true = run the platform with a fake core (no AI at all)

